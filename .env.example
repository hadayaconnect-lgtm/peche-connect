# Clé API Anthropic — nécessaire pour l'assistant IA
# Obtenez la vôtre sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optionnel — modèle à utiliser (par défaut: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase — nécessaire uniquement pour afficher les données satellite
# RÉELLES (Copernicus). Sans ces variables, l'app fonctionne normalement
# avec des données simulées. Variables publiques (clé anonyme, lecture
# seule) : sans risque à exposer côté client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
